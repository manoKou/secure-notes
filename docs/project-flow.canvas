    {
      "id": "g1",
      "type": "group",
      "x": 0,
      "y": 0,
      "width": 360,
      "height": 1490,
      "label": "Project roadmap",
      "color": "4"
    },
    {
      "id": "r1",
      "type": "text",
      "x": 40,
      "y": 60,
      "width": 280,
      "height": 90,
      "text": "## 1. Plan & decide\nStack, security, agents\n`bootstrap-process.md`",
      "color": "4"
    },
    {
      "id": "r2",
      "type": "text",
      "x": 40,
      "y": 190,
      "width": 280,
      "height": 90,
      "text": "## 2. Install dev tools\nComposer · PostgreSQL · RustFS · Node 22",
      "color": "4"
    },
    {
      "id": "r3",
      "type": "text",
      "x": 40,
      "y": 320,
      "width": 280,
      "height": 90,
      "text": "## 3. Decide file structure\n`docs/file-structure.md`",
      "color": "4"
    },
    {
      "id": "r4",
      "type": "text",
      "x": 40,
      "y": 450,
      "width": 280,
      "height": 90,
      "text": "## 4. Create Laravel project\nLivewire starter kit + Pest",
      "color": "3"
    },
    {
      "id": "r5",
      "type": "text",
      "x": 40,
      "y": 580,
      "width": 280,
      "height": 90,
      "text": "## 5. Skeleton app\nEmpty classes & methods"
    },
    {
      "id": "r6",
      "type": "text",
      "x": 40,
      "y": 710,
      "width": 280,
      "height": 90,
      "text": "## 6. Cut into tasks\nSmall, reviewable chunks"
    },
    {
      "id": "r7",
      "type": "text",
      "x": 40,
      "y": 840,
      "width": 280,
      "height": 90,
      "text": "## 7. Implement (Claude Code)\nProposes chunks → **I review**"
    },
    {
      "id": "r8",
      "type": "text",
      "x": 40,
      "y": 970,
      "width": 280,
      "height": 90,
      "text": "## 8. Test & review (Codex)\nTests from spec + security review"
    },
    {
      "id": "r9",
      "type": "text",
      "x": 40,
      "y": 1100,
      "width": 280,
      "height": 70,
      "text": "### Issues found?",
      "color": "2"
    },
    {
      "id": "r10",
      "type": "text",
      "x": 40,
      "y": 1230,
      "width": 280,
      "height": 90,
      "text": "## 9. Document\nREADME · AI_COLLABORATION.md"
    },
    {
      "id": "r11",
      "type": "text",
      "x": 40,
      "y": 1360,
      "width": 280,
      "height": 90,
      "text": "## 10. Deliver\nPush to Git"
    },
    {
      "id": "f1",
      "type": "text",
      "x": 480,
      "y": 60,
      "width": 320,
      "height": 90,
      "text": "**Browser**\nGET /notes/{note}/attachments/{attachment}"
    },
    {
      "id": "f2",
      "type": "text",
      "x": 480,
      "y": 190,
      "width": 320,
      "height": 90,
      "text": "**auth middleware**\nLogged in?"
    },
    {
      "id": "f3",
      "type": "text",
      "x": 480,
      "y": 320,
      "width": 320,
      "height": 90,
      "text": "**Scoped route binding**\nULIDs exist & attachment belongs to note?"
    },
    {
      "id": "f4",
      "type": "text",
      "x": 480,
      "y": 450,
      "width": 320,
      "height": 90,
      "text": "**NotePolicy@view**\nIs this my note?"
    },
    {
      "id": "f5",
      "type": "text",
      "x": 480,
      "y": 580,
      "width": 320,
      "height": 90,
      "text": "**AttachmentController@download**"
    },
    {
      "id": "f6",
      "type": "text",
      "x": 480,
      "y": 710,
      "width": 320,
      "height": 90,
      "text": "**AttachmentService**\nreads file via `s3` disk"
    },
    {
      "id": "f7",
      "type": "text",
      "x": 480,
      "y": 840,
      "width": 320,
      "height": 90,
      "text": "**RustFS** (private bucket)\n`secure-notes`",
      "color": "5"
    },
    {
      "id": "f8",
      "type": "text",
      "x": 480,
      "y": 970,
      "width": 320,
      "height": 100,
      "text": "**Response**\nstreamed download\n`Content-Disposition: attachment`\n`X-Content-Type-Options: nosniff`",
      "color": "4"
    },
    {
      "id": "x1",
      "type": "text",
      "x": 880,
      "y": 190,
      "width": 220,
      "height": 60,
      "text": "↪ redirect to /login",
      "color": "1"
    },
    {
      "id": "x2",
      "type": "text",
      "x": 880,
      "y": 385.0,
      "width": 220,
      "height": 80,
      "text": "**404 Not Found**\n(never reveal that it exists)",
      "color": "1"
    },
    {
      "id": "d1",
      "type": "text",
      "x": 1220,
      "y": 60,
      "width": 300,
      "height": 90,
      "text": "**users**\nid · name · email · password"
    },
    {
      "id": "d2",
      "type": "text",
      "x": 1220,
      "y": 210,
      "width": 300,
      "height": 90,
      "text": "**notes**\nid (ULID) · user_id · title · body"
    },
    {
      "id": "d3",
      "type": "text",
      "x": 1220,
      "y": 360,
      "width": 300,
      "height": 110,
      "text": "**attachments**\nid (ULID) · note_id · disk · path\noriginal_name · mime_type · size"
    }
  ],
